# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo
coverage/

# Runtime data & derived index (facts live in a git-backed data volume; SQLite index is derived)
data/
logs/
# Server data dir written when KRIMTO_DATA points at the repo: API key store,
# members.yaml, telemetry id. Never commit these.
.krimto/
*.db
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# Secrets / env
.env
.env.*
!.env.example

# OS / editor artifacts
.DS_Store
.specstory/
.vscode/
.idea/

# Internal documents — MUST NOT be published to the public repo.
# files/ is the original planning drop; docs/ holds the strategy/spec/explainer
# dossiers. Both stay on disk for local dev tooling but are never committed.
files/
docs/

# Development-only Claude Code setup (dev subagents, dev hooks). Per the setup
# playbook this is "not shipped". Kept on disk locally; never committed.
.claude/
